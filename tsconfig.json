{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "rootDir": "./src",
        "moduleResolution": "node",
        "types": [
            "jest",
            "node"
        ],
        "outDir": "./build",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
}
